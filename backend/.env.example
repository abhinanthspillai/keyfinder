# =============================================================================
# Key Finder Backend Environment Configuration
# =============================================================================

# Secret API key sent by ESP32 in "X-API-Key" header (must match DEVICE_API_KEY in config.h)
DEVICE_API_KEY=super_secret_key_12345
API_KEY=super_secret_key_12345

# Quick-ring shortcut token (used by /quick page on phone home screen)
# Pick any random string. Example: openssl rand -hex 16
QUICK_TOKEN=change_me_quick_token

# Device configuration
DEVICE_ID=esp32_keys_01
OFFLINE_THRESHOLD_SECONDS=15

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get your token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of numeric Telegram Chat IDs permitted to use the bot.
# Anyone not in this list will be ignored. Example: 123456789,987654321
ALLOWED_CHAT_IDS=123456789

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
